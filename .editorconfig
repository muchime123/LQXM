root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{java,xml,yml,yaml,json,properties,sql}]
indent_style = space
indent_size = 2

[*.{vue,js,ts,jsx,tsx,css,scss,html}]
indent_style = space
indent_size = 2

[Makefile]
indent_style = tab

[*.md]
trim_trailing_whitespace = false

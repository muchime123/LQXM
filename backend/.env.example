DB_USERNAME=root
DB_PASSWORD=CHANGE_ME
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/product_archive?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false
# Must be a private Base64 value that decodes to 32 bytes (AES-256).
CRYPTO_SECRET_KEY=CHANGE_ME
LOCAL_OPEN_FOLDER_ENABLED=false
FILES_ROOT=../storage/lq-files

# ===== P6.1 钉钉集成（敏感值勿提交） =====
# 是否启用钉钉报销同步功能（true=启用，false=关闭时同步端点返回 503）
DINGTALK_ENABLED=false
# 企业内部应用 AppKey（钉钉开放平台 → 凭证与基础信息）
DINGTALK_APP_KEY=CHANGE_ME
# 企业内部应用 AppSecret（仅后端可读，不要写回仓库）
DINGTALK_APP_SECRET=CHANGE_ME
# 日常报销审批模板 ProcessCode（钉钉审批后台 → 日常报销模板 → 开发配置）
DINGTALK_PROCESS_CODE=CHANGE_ME

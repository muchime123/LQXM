# 高德地图 JS API 配置
# 申请地址：https://console.amap.com/dev/key/app
# 选择 "Web端（JS API）" 类型
VITE_AMAP_KEY=your_amap_key_here
# 若启用了"配置安全密钥"校验，需同时填写安全密钥；否则留空
VITE_AMAP_SECURITY_CODE=your_security_code_here

# 站点主域名（canonical / og:url / sitemap 使用）
# 国内站与外贸站共用同一套代码时，用这份配置切换收录域名，不要改源码。
# 未配置时回退 https://www.liqiangbz.com
VITE_SITE_URL=https://www.liqiangbz.com

# 内容来源：snapshot（首版静态快照） | api（动态后端）
# 生产构建不设置也默认 snapshot；本地开发默认 api。
# 若要本地模拟首版静态站，才取消下一行注释：
# VITE_WEBSITE_CONTENT_SOURCE=snapshot

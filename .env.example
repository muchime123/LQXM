# Backend database
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/product_archive?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false
DB_USERNAME=root
DB_PASSWORD=CHANGE_ME

# Backend file storage
FILES_ROOT=../storage/lq-files

# Password encryption key. Must be a private Base64 value that decodes to 32 bytes.
CRYPTO_SECRET_KEY=CHANGE_ME

# Desktop-only helper. Keep disabled on shared servers and Docker deployments.
LOCAL_OPEN_FOLDER_ENABLED=false

# Office preview conversion
OFFICE_CONVERTER_PATH=C:/Program Files/LibreOffice/program/soffice.com
OFFICE_CONVERTER_TIMEOUT_SECONDS=60

# AI provider selection: openai, doubao, wenxin, deepseek
AI_PROVIDER=doubao
AI_API_KEY=
AI_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
AI_MODEL=doubao-seed-2-1-pro-260628

OPENAI_API_KEY=
DOUBAO_API_KEY=
WENXIN_API_KEY=
DEEPSEEK_API_KEY=
